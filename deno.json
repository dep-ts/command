{
  "name": "@dep/command",
  "version": "3.0.0",
  "exports": "./src/main.ts",
  "compilerOptions": {
    "strict": true
  },
  "imports": {
    "@/": "./src/",
    "@dep/assert": "jsr:@dep/assert@^1.3.0",
    "@dep/table": "jsr:@dep/table@^1.0.1"
  },
  "tasks": {
    "start": "deno run --allow-all src/main.ts",
    "build": "deno run --allow-all src/build.ts",
    "dev": "deno run --allow-all --watch src/main.ts",
    "check-types": "deno check src/**/*.ts && deno publish --check",
    "docs": "lineo md 'src/**/*.ts' --outFile code.md --outDir temp",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "clean": "rm -rf dist",
    "pack": "deno compile -A -o command ./cli.ts",
    "prerelease": "deno lint && deno fmt",
    "release": "deno task prerelease && jsr publish ./"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}
